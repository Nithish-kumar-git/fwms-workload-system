# ============================================
# DEPLOYMENT ENVIRONMENT
# ============================================
ENV=development

# ============================================
# DATABASE (ON-PREM OR CLOUD)
# ============================================
DATABASE_URL=postgresql://faculty_user:faculty_password@localhost:5432/faculty_selection

# Connection pool settings (CONSERVATIVE DEFAULTS)
POOL_SIZE=10
POOL_MAX_OVERFLOW=20

# ============================================
# GOOGLE OAUTH (PLACEHOLDER - Replace with real credentials)
# ============================================
GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Email domain validation
ALLOWED_EMAIL_DOMAIN=hindustanuniv.ac.in

# ============================================
# SESSION MANAGEMENT (Redis OPTIONAL)
# ============================================
SESSION_BACKEND=memory
SESSION_EXPIRATION_HOURS=4

# ============================================
# EMAIL BACKEND
# ============================================
EMAIL_BACKEND=log

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# ============================================
# SECURITY
# ============================================
SECRET_KEY=dev-secret-key-replace-in-production-min-32-characters-long

# ============================================
# RATE LIMITING (OPTIONAL)
# ============================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_BACKEND=memory
