# ============================================
# COPY THIS FILE TO .env AND FILL IN VALUES
# NEVER COMMIT .env TO GITHUB
# ============================================

# Application
ENV=development
# In production set to: production

# Security - generate a random 32+ character string
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_32_CHAR_STRING_NEVER_SHARE_THIS

# Authentication
# Set to True ONLY for local development testing
# MUST be False in production
DEV_AUTH_BYPASS=True

# Google OAuth - get from console.cloud.google.com
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET

# Database - Railway provides this automatically in production
# For local development with Docker:
DATABASE_URL=postgresql://postgres:postgres@db:5432/faculty_selection

# Frontend URL - used for CORS and OAuth redirect
# Local development:
FRONTEND_URL=http://localhost:5173
# Production (fill after Vercel deployment):
# FRONTEND_URL=https://your-app.vercel.app

# Session (optional - use redis in production)
# SESSION_BACKEND=redis
# REDIS_URL=redis://localhost:6379

# ============================================
# RAILWAY DEPLOYMENT - set these in Railway dashboard
# Do NOT put real values in this file
# ============================================
# DATABASE_URL=auto-set-by-railway
# SECRET_KEY=set-in-railway-dashboard
# GOOGLE_CLIENT_ID=set-in-railway-dashboard
# GOOGLE_CLIENT_SECRET=set-in-railway-dashboard
# FRONTEND_URL=https://your-vercel-url.vercel.app
# ENV=production
# DEV_AUTH_BYPASS=False
